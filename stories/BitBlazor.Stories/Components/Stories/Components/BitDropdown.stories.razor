@attribute [Stories("Components/BitDropdown")]

<Stories TComponent="BitDropdown">
    <ArgType For="_ => _.ActivatorId" DefaultValue="@("dropdownMenu")" />
    <ArgType For="_ => _.ActivatorLabel" DefaultValue="@("Open")" />
    <ArgType For="_ => _.Position" DefaultValue="@DropdownPosition.Down" />

    <Story Name="Default">
        <Arguments>
            <Arg For="_ => _.ActivatorId" Value="@("dropdownMenu")" />
            <Arg For="_ => _.ActivatorLabel" Value="@("Open")" />
            <Arg For="_ => _.Position" Value="DropdownPosition.Down" />
        </Arguments>

        <Template>
            <div class="px-2 py-2 text-center">
                <BitDropdown @attributes="context.Args" CssClass="text-center">
                    <BitDropdownItem><span>Action 1</span></BitDropdownItem>
                    <BitDropdownItem><span>Action 2</span></BitDropdownItem>
                    <BitDropdownItem><span>Action 3</span></BitDropdownItem>
                </BitDropdown>
            </div>
        </Template>
    </Story>

    <Story Name="Dropup">
        <Template>
            <div class="px-2 py-2 text-center">
                <BitDropdown ActivatorId="dropupMenu" ActivatorLabel="Open" Position="DropdownPosition.Up">
                    <BitDropdownItem><span>Action 1</span></BitDropdownItem>
                    <BitDropdownItem><span>Action 2</span></BitDropdownItem>
                    <BitDropdownItem><span>Action 3</span></BitDropdownItem>
                </BitDropdown>
            </div>
        </Template>
    </Story>

    <Story Name="Dropend">
        <Template>
            <div class="px-2 py-2 text-center">
                <BitDropdown ActivatorId="dropendMenu" ActivatorLabel="Open" Position="DropdownPosition.End">
                    <BitDropdownItem><span>Action 1</span></BitDropdownItem>
                    <BitDropdownItem><span>Action 2</span></BitDropdownItem>
                    <BitDropdownItem><span>Action 3</span></BitDropdownItem>
                </BitDropdown>
            </div>
        </Template>
    </Story>

    <Story Name="Dropstart">
        <Template>
            <div class="px-2 py-2 text-center">
                <BitDropdown ActivatorId="dropstartMenu" ActivatorLabel="Open" Position="DropdownPosition.Start">
                    <BitDropdownItem><span>Action 1</span></BitDropdownItem>
                    <BitDropdownItem><span>Action 2</span></BitDropdownItem>
                    <BitDropdownItem><span>Action 3</span></BitDropdownItem>
                </BitDropdown>
            </div>
        </Template>
    </Story>
</Stories>
